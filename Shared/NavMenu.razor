<nav class="tree-nav">
    <h2 class="tree-title">Portfolio</h2>
    <AuthorizeView>
    <Authorized>
        <a href="MicrosoftIdentity/Account/SignOut">Sign out</a>
    </Authorized>
    <NotAuthorized>
        <a href="account/sign-up-sign-in">Sign up / sign in</a>
    </NotAuthorized>
</AuthorizeView>

    <ul class="tree-list">
        <li class="tree-section">
            <button class="section-toggle" @onclick='() => Toggle("web-development")' aria-expanded='@(IsOpen("web-development").ToString().ToLowerInvariant())'>
                <svg class="chev" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="section-label">Web Development</span>
            </button>
            <ul class="section-list" style='display:@(IsOpen("web-development") ? "block" : "none")'>
                <li><NavLink class="nav-item" href="/projects/web-development/overview">Overview</NavLink></li>
                <li><NavLink class="nav-item" href="/projects/web-development/frontend">Frontend</NavLink></li>
                <li><NavLink class="nav-item" href="/projects/web-development/backend">Backend</NavLink></li>
                <li><NavLink class="nav-item" href="/projects/web-development/architecture">Architecture</NavLink></li>
                <li><NavLink class="nav-item" href="/projects/web-development/apis">APIs</NavLink></li>
            </ul>
        </li>

        <li class="tree-section">
            <button class="section-toggle" @onclick='() => Toggle("game-development")' aria-expanded='@(IsOpen("game-development").ToString().ToLowerInvariant())'>
                <svg class="chev" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="section-label">Game Development</span>
            </button>
            <ul class="section-list" style='display:@(IsOpen("game-development") ? "block" : "none")'>
                <li><NavLink class="nav-item" href="/projects/game-development/overview">Overview</NavLink></li>
                <li><NavLink class="nav-item" href="/projects/game-development/infiniroller">Infiniroller</NavLink></li>
                <li><NavLink class="nav-item" href="/projects/game-development/versus-with-verses">Versus With Verses</NavLink></li>
                <li><NavLink class="nav-item" href="/projects/game-development/background">Background</NavLink></li>
            </ul>
        </li>

        <li class="tree-section">
            <button class="section-toggle" @onclick='() => Toggle("creative-writing")' aria-expanded='@(IsOpen("creative-writing").ToString().ToLowerInvariant())'>
                <svg class="chev" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="section-label">Creative Writing</span>
            </button>
            <ul class="section-list" style='display:@(IsOpen("creative-writing") ? "block" : "none")'>
                <li><NavLink class="nav-item" href="/projects/creative-writing/overview">Overview</NavLink></li>
                <li><NavLink class="nav-item" href="/projects/creative-writing/flameheart">Flameheart</NavLink></li>
                <li><NavLink class="nav-item" href="/projects/creative-writing/tristar-chronicles">Tristar Chronicles</NavLink></li>
                <li><NavLink class="nav-item" href="/projects/creative-writing/not-able">Not Able</NavLink></li>
            </ul>
        </li>
    </ul>

    <div class="nav-divider"></div>

    <ul class="tree-list">
        <li><NavLink class="nav-item" href="/ai-disclaimer">AI & My Work</NavLink></li>
    </ul>
</nav>

@code {
    private readonly System.Collections.Generic.HashSet<string> _open = new();

    private void Toggle(string key)
    {
        if (_open.Contains(key)) _open.Remove(key);
        else _open.Add(key);
    }

    private bool IsOpen(string key) => _open.Contains(key);
}
